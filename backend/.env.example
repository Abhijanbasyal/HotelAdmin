# ============================================================
# Hotel Management Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to source control.

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_VERSION=v1

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/hotel_management

# ── JWT ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_STRONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=hotel-management-api
JWT_AUDIENCE=hotel-management-app

# ── Cookie ───────────────────────────────────────────────────
COOKIE_SECRET=CHANGE_ME_COOKIE_SIGNING_SECRET
COOKIE_DOMAIN=localhost

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Asset Storage ────────────────────────────────────────────
# Absolute path to your dedicated storage device/directory.
# Must be outside the application source directory.
ASSET_STORAGE_ROOT=C:/hotel-storage/assets

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug
